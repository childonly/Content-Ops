# Content Ops Hub - 环境变量配置
# 复制此文件为 .env 并修改值

# 服务端口
PORT=3100

# 运行环境
NODE_ENV=development

# 数据库路径
DB_PATH=./data/content-ops-hub.db

# 前端地址 (CORS)
CLIENT_URL=http://localhost:5180

# Skill Bridge 模式: mock (模拟数据) | trae (真实技能调用)
SKILL_BRIDGE_MODE=mock

# TikHub API Key (真实调用趋势/标签/分析技能时需要)
# 获取地址: https://tikhub.io
TIKHUB_API_KEY=your_tikhub_api_key_here

# 小红书 Skill 安装路径
XHS_SKILL_PATH=C:\Users\wml1027\.trae-cn\skills\xiaohongshu-skill

# Ollama 本地模型配置 (内容生成)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# Pipeline 配置
# 是否自动推进到下一阶段
PIPELINE_AUTO_ADVANCE=false
# 阶段超时时间 (毫秒)
PIPELINE_STAGE_TIMEOUT=300000

# 日志级别: debug | info | warn | error
LOG_LEVEL=info
